<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Open Dot hears the person through the microphone. A signed build runs under the
	     hardened runtime, where audio input needs this as well as the usage line in
	     Info.plist; without it the microphone gives only silence. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
